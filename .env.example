# ---------------------------------------------------------------------------
# Orca Coast Growth Engine — Environment Variables
# Copy to `.env` and fill in. The app runs in DEMO mode with no keys set:
# all external providers fall back to deterministic local implementations.
# ---------------------------------------------------------------------------

# Database (PostgreSQL). Used by Prisma in production.
DATABASE_URL="postgresql://user:password@localhost:5432/orca_coast?schema=public"

# Data source: "seed" (default, runs without a DB) | "prisma" (use PostgreSQL)
DATA_SOURCE="seed"

# --- AI (OpenAI) -----------------------------------------------------------
# If unset, AI email/proposal generation uses the deterministic template engine.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# --- Lead Discovery --------------------------------------------------------
GOOGLE_MAPS_API_KEY=""

# --- Contact Enrichment ----------------------------------------------------
APOLLO_API_KEY=""
CLEARBIT_API_KEY=""
HUNTER_API_KEY=""

# --- Email Delivery --------------------------------------------------------
# Provider: "gmail" | "resend" | "sendgrid" | "console" (default; logs only)
EMAIL_PROVIDER="console"
EMAIL_FROM="growth@orcacoastplaygrounds.com"

# Gmail: sequence steps create a Gmail DRAFT by default (review before send).
# Set EMAIL_SEND_MODE="send" to send directly.
# Get a refresh token via Google OAuth (scope: gmail.compose / gmail.send).
EMAIL_SEND_MODE="draft"
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_SENDER="kathleen@marketone.ca"

# Other providers
SENDGRID_API_KEY=""
RESEND_API_KEY=""

# --- Auth (Clerk) ----------------------------------------------------------
# If unset, the app uses a local demo session.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
