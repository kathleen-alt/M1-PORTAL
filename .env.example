# ── Market One Content Intelligence Portal ────────────────────────────────────
# Copy this file to `.env` and fill in your keys.

# Required — your Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Optional but recommended — a free NewsAPI key (https://newsapi.org).
# When present, the server pulls real articles restricted to a credible-domain
# allowlist and Claude classifies each one. When absent, the server falls back
# to Claude's web-search tool to find real, sourced stories.
NEWS_API_KEY=

# Model used for classification + copy generation. Defaults to claude-sonnet-4-6.
# Use claude-opus-4-8 for the highest-quality copy generation if you prefer.
ANTHROPIC_MODEL=claude-sonnet-4-6

# API port. The Vite dev client proxies /api to this port.
PORT=3001

# Brand edition: "marketone" (default) or "bullionaire" (precious-metals).
# Selects the server's pillars, per-pillar search queries, and theme.
BRAND=marketone

# Optional — an Incoming Webhook URL to post approval/publish alerts to Slack.
# Leave blank to keep alerts in the in-app feed only.
SLACK_WEBHOOK_URL=

# ── Issuer intelligence ───────────────────────────────────────────────────────
# The prospecting pipeline (NASDAQ / OTC / TSXV / CSE -> Yahoo Finance ->
# company websites) needs no API keys; every source is public. These tune it.

# Politeness: minimum gap between requests to the same host, in ms.
ISSUERS_HOST_DELAY_MS=350

# User-agent sent to exchange sites, Yahoo and company websites.
# ISSUERS_USER_AGENT=

# Minimum share of the scoring model that must evaluate before an issuer is
# given a sales-facing tier. Below it the record is held at "U - unverified".
ISSUERS_MIN_COVERAGE=60

# Peer medians are computed from the tracked universe, but only once a group is
# this large; below it the model uses market-wide baselines instead. Keep this
# high enough that a small, pre-filtered shortlist cannot become its own baseline.
ISSUERS_MIN_PEER_N=30

# Market-wide fallback baselines: typical average daily dollar volume per cap
# band, and the dollars-traded-per-watcher pool median.
# ISSUERS_BASELINE_VOL_NANO=150000
# ISSUERS_BASELINE_VOL_MICRO=1500000
# ISSUERS_BASELINE_VOL_SMALL=8000000
# ISSUERS_BASELINE_PER_WATCHER=802

# Override source endpoints if one moves.
# OTC_API_BASE=https://backend.otcmarkets.com/otcapi
# TMX_DIRECTORY_BASE=https://www.tsx.com/json/company-directory/search
# CSE_LISTINGS_URLS=https://thecse.com/en/listings.csv
