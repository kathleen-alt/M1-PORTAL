# ---------------------------------------------------------------------------
# Orca Coast Growth Engine — Environment Variables
# Copy to `.env` and fill in. The app runs in DEMO mode with no keys set:
# all external providers fall back to deterministic local implementations.
# ---------------------------------------------------------------------------

# Database (PostgreSQL). Used by Prisma in production.
DATABASE_URL="postgresql://user:password@localhost:5432/orca_coast?schema=public"

# Data source: "seed" (default, runs without a DB) | "prisma" (use PostgreSQL)
DATA_SOURCE="seed"

# --- AI (OpenAI) -----------------------------------------------------------
# If unset, AI email/proposal generation uses the deterministic template engine.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# --- Lead Discovery --------------------------------------------------------
GOOGLE_MAPS_API_KEY=""

# --- Contact Enrichment ----------------------------------------------------
APOLLO_API_KEY=""
CLEARBIT_API_KEY=""
HUNTER_API_KEY=""

# --- Email Delivery --------------------------------------------------------
# Provider: "sendgrid" | "resend" | "console" (default; logs instead of sends)
EMAIL_PROVIDER="console"
SENDGRID_API_KEY=""
RESEND_API_KEY=""
EMAIL_FROM="growth@orcacoastplaygrounds.com"

# --- Auth (Clerk) ----------------------------------------------------------
# If unset, the app uses a local demo session.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
