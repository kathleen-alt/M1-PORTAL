# ── Market One Content Intelligence Portal ────────────────────────────────────
# Copy this file to `.env` and fill in your keys.

# Required — your Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Optional but recommended — a free NewsAPI key (https://newsapi.org).
# When present, the server pulls real articles restricted to a credible-domain
# allowlist and Claude classifies each one. When absent, the server falls back
# to Claude's web-search tool to find real, sourced stories.
NEWS_API_KEY=

# Model used for classification + copy generation. Defaults to claude-sonnet-4-6.
# Use claude-opus-4-8 for the highest-quality copy generation if you prefer.
ANTHROPIC_MODEL=claude-sonnet-4-6

# API port. The Vite dev client proxies /api to this port.
PORT=3001

# Brand edition: "marketone" (default) or "bullionaire" (precious-metals).
# Selects the server's pillars, per-pillar search queries, and theme.
BRAND=marketone

# Optional — an Incoming Webhook URL to post approval/publish alerts to Slack.
# Leave blank to keep alerts in the in-app feed only.
SLACK_WEBHOOK_URL=
