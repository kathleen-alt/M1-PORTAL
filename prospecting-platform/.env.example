# Market One — Prospecting & Outreach Platform
# Copy to .env and fill in. The platform runs fully in Demo mode with no keys.

# Anthropic API key — powers contact enrichment, the AI research agent, and the
# AI outreach writer. Without it, the app stays in Demo mode (bundled sample data).
ANTHROPIC_API_KEY=

# Model used for the AI features.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Server port.
PORT=4100
